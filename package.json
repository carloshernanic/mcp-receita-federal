{
  "name": "mcp-receita-federal",
  "version": "0.1.0",
  "description": "Servidor MCP para as calculadoras open source da Reforma Tributária (Receita Federal): CBS, IBS, IS, Simples Nacional e DANFSe.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-receita-federal": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/smoke.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "npm run build && node dist/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
